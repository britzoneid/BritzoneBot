{
	"type": "module",
	"name": "britzone-bot",
	"version": "2.0.0",
	"description": "Discord bot designed to manage breakout rooms for voice channels",
	"main": "dist/index.js",
	"scripts": {
		"clean": "rimraf dist",
		"build": "bun run clean && tsc",
		"start": "bun dist/index.js",
		"deploy": "bun dist/deployCommandsLocal.js",
		"dev": "bun --watch src/index.ts",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"pino-pretty": "^13.1.3",
		"discord.js": "^14.27.0",
		"dotenv": "^17.4.2",
		"pino": "^10.3.1",
		"pino-roll": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/node": "^26.1.2",
		"lefthook": "^2.1.10",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2"
	}
}
